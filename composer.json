{
    "name": "ogmdev/castor-devtools",
    "description": "Castor building blocks to drive a Docker Compose web stack: compose commands, git worktrees, quality tools, Vite, an environment doctor, and one local Traefik ingress with mkcert TLS shared by every project.",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": [
        "castor",
        "docker",
        "docker-compose",
        "traefik",
        "mkcert",
        "laravel",
        "developer-experience"
    ],
    "authors": [
        {
            "name": "Olivier Grandmougin"
        }
    ],
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "jolicode/castor": "^1.9",
        "laravel/pint": "^1.25",
        "pestphp/pest": "^4.1 || ^5.0",
        "phpstan/phpstan": "^2.1",
        "symfony/yaml": "^8.1"
    },
    "conflict": {
        "jolicode/castor": "<1.9"
    },
    "autoload": {
        "psr-4": {
            "Ogmdev\\CastorDevtools\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ogmdev\\CastorDevtools\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "phpstan": "phpstan analyse --memory-limit=512M --no-progress",
        "pint": "pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "jolicode/castor": "^1.9: the classes run inside Castor task files and call its functions (run, capture, exit_code, context, io, parallel)."
    }
}
